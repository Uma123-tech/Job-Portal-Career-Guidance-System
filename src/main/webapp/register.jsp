<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account | CareerLaunch</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="includes/header.jspf" %>
<main class="auth-wrap"><section class="auth-card"><p class="eyebrow">START YOUR JOURNEY</p><h1>Create an account.</h1><p class="muted">Join as a job seeker. Recruiter access can be enabled for demo purposes in MySQL.</p>
<%if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%>
<form method="post" action="<%=request.getContextPath()%>/register" class="stack-form"><label>Full name<input name="fullName" required maxlength="100" autocomplete="name"></label><label>Email address<input type="email" name="email" required maxlength="150" autocomplete="email"></label><label>Password<input type="password" name="password" required minlength="8" autocomplete="new-password"><small>Use at least 8 characters.</small></label><button class="btn btn-block">Create account</button></form><p class="form-foot">Already registered? <a href="<%=request.getContextPath()%>/login.jsp">Log in</a></p></section></main></body></html>