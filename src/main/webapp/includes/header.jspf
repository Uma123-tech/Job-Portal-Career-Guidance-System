<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.jobportal.model.User" %>
<%
String ctx=request.getContextPath();
User currentUser=(User)session.getAttribute("user");
%>
<header class="topbar">
  <a class="brand" href="<%=ctx%>/jobs">Career<span>Launch</span></a>
  <nav>
    <a href="<%=ctx%>/jobs">Find jobs</a>
    <a href="<%=ctx%>/career-guidance.jsp">Career guidance</a>
    <% if(currentUser!=null){ %>
      <a href="<%=ctx%>/dashboard">Dashboard</a>
      <% if(currentUser.isRecruiter()){ %><a href="<%=ctx%>/post-job.jsp">Post a job</a><% } %>
      <a class="nav-cta" href="<%=ctx%>/logout">Log out</a>
    <% } else { %>
      <a href="<%=ctx%>/login.jsp">Log in</a><a class="nav-cta" href="<%=ctx%>/register.jsp">Get started</a>
    <% } %>
  </nav>
</header>
